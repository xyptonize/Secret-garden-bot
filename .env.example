# ---- Required ----
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here
# "Application ID" from the General Information page of your app
CLIENT_ID=your-application-id-here

# ---- Recommended ----
# Your server (guild) ID. If set, slash commands register instantly to just this server.
# Leave empty to register commands globally (can take up to 1 hour to appear).
# Enable Developer Mode in Discord, then right-click your server icon -> Copy Server ID.
GUILD_ID=

# Default channel for new-record announcements (right-click a channel -> Copy Channel ID).
# You can also set this per-server at runtime with the /setchannel command.
ANNOUNCE_CHANNEL_ID=

# ---- Optional tuning ----
# How often to check the CS2KZ API for new records, in seconds (default 120).
POLL_INTERVAL_SECONDS=120

# Only announce runs worth at least this many points (0 = announce every new run).
ANNOUNCE_MIN_POINTS=0

# Default mode for /rankings when the user doesn't specify one: ckz (classic) or vnl (vanilla).
DEFAULT_MODE=ckz

# ---- Leaderboard & rank roles ----
# How often (seconds) to refresh the pinned leaderboard and re-sync rank roles (default 900 = 15 min).
LEADERBOARD_INTERVAL_SECONDS=900

# Set to false to disable auto-creating/assigning the CKZ rank roles.
ENABLE_RANK_ROLES=true

# Announce when a member climbs into a higher CKZ rank (posts to the announcement channel above).
ENABLE_RANKUP_ANNOUNCEMENTS=true

# Prefix for the auto-created rank roles: "CKZ" -> roles named "CKZ Noob", "CKZ Pro", ...
RANK_ROLE_PREFIX=CKZ

# Title shown on the pinned leaderboard embed (e.g. your server's name).
LEADERBOARD_TITLE=CS2KZ Leaderboard — CKZ

# Parent command name — every command lives under this, e.g. /sgkz register, /sgkz leaderboard setup.
# Handy when your server has many bots and slash-command names collide.
COMMAND_ROOT=sgkz

# ---- Birthday reminders (/sghb) ----
# Command root for birthday commands (keep the sg*** pattern).
BIRTHDAY_COMMAND_ROOT=sghb
# Default birthday channel (or set it with /sghb setchannel).
BIRTHDAY_CHANNEL_ID=
# Hour (0-23) to post the birthday message, and the timezone it's measured in.
BIRTHDAY_HOUR=9
BIRTHDAY_TIMEZONE=Asia/Ulaanbaatar

# ---- CS2 team drafter (/sgdraft) ----
DRAFT_COMMAND_ROOT=sgdraft
# Role that marks girl players (role name or id). Each team gets one when there are enough.
DRAFT_GIRL_ROLE=HOT GIRLS🎀
# Aura values for the named roles ("AURA - 1" .. "AURA - 10" use their number; lower = stronger).
DRAFT_AURA_INFINITY=-0.5
DRAFT_AURA_GOD=0
DRAFT_AURA_KING=0.5
# Aura used for players with no AURA role (shown with ❔).
DRAFT_DEFAULT_AURA=5.5
# Reshuffle picks lineups whose aura difference is within this much of the best one.
DRAFT_RESHUFFLE_TOLERANCE=1
# Keep open lobbies at the bottom of their channel: re-post after this many quiet seconds (0 = off).
DRAFT_STICKY_SECONDS=5

# ---- Phone verification (/sgphone) ----
# API key from the https://verify.mn Developer Console (starts with vrf_). When set, a number is
# only saved after the member texts a one-time code to 144773 from it — so it has to exist and be
# theirs. Mongolian numbers only. Leave empty to save numbers without checking.
VERIFY_MN_API_KEY=

# Base URL of the CS2KZ API (only change if it moves).
CS2KZ_API_BASE=https://api.cs2kz.org
